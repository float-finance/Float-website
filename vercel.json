{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/credit", "destination": "/credit-check", "permanent": false },
    { "source": "/credit-check/", "destination": "/credit-check", "permanent": false }
  ],
  "rewrites": [
    { "source": "/credit-check", "destination": "https://credit-production-7d2a3d98.up.railway.app/credit-check" },
    { "source": "/credit-check/:path*", "destination": "https://credit-production-7d2a3d98.up.railway.app/credit-check/:path*" }
  ]
}
